  1529   exec sql                                                                                                           000471
  1530     CALL QSYS2.IFS_WRITE_UTF8(                                                                                       000472
  1531            PATH_NAME => '/tmp/pkgtest_map.json',                                                                     000473
  1532            LINE      => :JsonText,                                                                                   000474
  1533            OVERWRITE => 'REPLACE',                                                                                   000475
  1534            END_OF_LINE => 'NONE');                                                                                   000476
  1535                                                                                                                      000477
  1536   // 3. First unpack to establish baseline objects in PKGTSTDTA and PKGTSTPGM                                        000478
  1537   CmdOk = ExecCl('#UNPACK INPTYPE(*SAVF) SAVF(QTEMP/SAVFALL) '                                                       000479
  1538                + 'MAPFILE(''' + JSON_PATH + ''')');                                                                  000480
  1539   assert(CmdOk: 'Initial #UNPACK with MAPFILE should succeed');                                                      000481
  1540                                                                                                                      000482
  1541   // 4. Modify target data & authorities on existing objects in PKGTSTDTA:                                           000483
  1542   //    - Set *PUBLIC authority on TSTCUSTPF to *USE                                                                 000484
  1543   //    - Insert a production customer row (999) into PKGTSTDTA.TSTCUSTPF                                            000485
  1544   //    - Update PKGTSTDTA.TSTSYSCFG to 'OLD_LOCAL_VALUE'                                                            000486
  1545   ExecCl('GRTOBJAUT OBJ(' + TEST_DTA_LIB + '/TSTCUSTPF) OBJTYPE(*FILE) '                                             000487
  1546        + 'USER(*PUBLIC) AUT(*USE) REPLACE(*YES)');                                                                   000488
  1547                                                                                                                      000489
  1548   exec sql                                                                                                           000490
  1549     INSERT INTO PKGTSTDTA.TSTCUSTPF VALUES (999, 'EXISTING PROD CUSTOMER');                                          000491
  1550   exec sql                                                                                                           000492
  1551     UPDATE PKGTSTDTA.TSTSYSCFG SET CFGVAL = 'OLD_LOCAL_VALUE';                                                       000493
  1552                                                                                                                      000494
  1553   // 5. Re-unpack over the existing objects with Rollback Save File enabled                                          000495
  1554   CmdOk = ExecCl('#UNPACK INPTYPE(*SAVF) SAVF(QTEMP/SAVFALL) '                                                       000496
  1555                + 'MAPFILE(''' + JSON_PATH + ''') '                                                                   000497
  1556                + 'BKPSAVF(QTEMP/BKPSAVF)');                                                                          000498
  1557   assert(CmdOk: 'Replacement #UNPACK with MAPFILE should succeed');                                                  000499
  1558                                                                                                                      000500
  1559   // 6a. Assert library mapping worked and version stamp is present                                                  000501
  1560   aEqual(EXP_VER: GetObjVersionStamp(TEST_DTA_LIB: 'TSTCUSTPF': '*FILE'));                                           000502
  1561   aEqual(EXP_VER: GetObjVersionStamp(TEST_DTA_LIB: 'TSTCUSTVW': '*FILE'));                                           000503
  1562   aEqual(EXP_VER: GetObjVersionStamp(TEST_PGM_LIB: 'TSTPGM1':   '*PGM'));                                            000504
  1563                                                                                                                      000505
  1564   // 6b. Assert *PUBLIC authority (*USE) on PKGTSTDTA/TSTCUSTPF was preserved                                        000506
  1565   exec sql                                                                                                           000507
  1566     SELECT COALESCE(OBJECT_AUTHORITY, '')                                                                            000508
  1567       INTO :PubAut                                                                                                   000509
  1568       FROM QSYS2.OBJECT_PRIVILEGES                                                                                   000510
  1569      WHERE SYSTEM_OBJECT_SCHEMA = 'PKGTSTDTA'                                                                        000511
  1570        AND SYSTEM_OBJECT_NAME   = 'TSTCUSTPF'                                                                        000512
  1571        AND OBJECT_TYPE          = '*FILE'                                                                            000513
  1572        AND AUTHORIZATION_NAME   = '*PUBLIC'                                                                          000514
  1573      FETCH FIRST 1 ROW ONLY;                                                                                         000515
  1574   aEqual('*USE': %trim(PubAut));                                                                                     000516
