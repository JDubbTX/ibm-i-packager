 1137          + %trim(ToolLib) + '/UNPACKC)');                                                                000076   10/18/26
 1138     ExecCl('CRTDUPOBJ OBJ(UNPACK) FROMLIB(' + %trim(ToolLib)                                             000077   10/18/26
 1139          + ') OBJTYPE(*CMD) TOLIB(' + %trim(ToolLib) + ') NEWOBJ(#UNPACK)');                             000078   10/18/26
 1140     ExecCl('CHGCMD CMD(' + %trim(ToolLib) + '/#UNPACK) PGM('                                             000079   10/18/26
 1141          + %trim(ToolLib) + '/UNPACKC)');                                                                000080   10/18/26
