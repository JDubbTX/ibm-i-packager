  1183         FROM PKGTSTSRC.TSTCUSTPF;                                                                                    000125
  1184                                                                                                                      000126
  1185   // 4. Create Source Physical File in QTEMP to compile *MODULE, *SRVPGM,                                            000127
  1186   //    *PGM (RPGLE & CLLE), and *CMD fixtures                                                                       000128
  1187   ExecCl('DLTF FILE(QTEMP/QTESTSRC)');                                                                               000129
  1188   ExecCl('CRTSRCPF FILE(QTEMP/QTESTSRC) RCDLEN(112)');                                                               000130
  1189                                                                                                                      000131
  1190   // 4a. RPGLE Module & Service Program (TSTMOD1 -> TSTSRVPGM)                                                       000132
  1191   WriteSrcMbr('TSTMOD1': 'RPGLE':                                                                                    000133
  1192               '**FREE' + x'25'                                                                                       000134
  1193             + 'ctl-opt nomain;' + x'25'                                                                              000135
  1194             + 'dcl-proc CalcTax export;' + x'25'                                                                     000136
  1195             + '  dcl-pi *n packed(11:2);' + x'25'                                                                    000137
  1196             + '    pAmt packed(11:2) const;' + x'25'                                                                 000138
  1197             + '  end-pi;' + x'25'                                                                                    000139
  1198             + '  return pAmt * 0.05;' + x'25'                                                                        000140
  1199             + 'end-proc;');                                                                                          000141
  1200   ExecCl('CRTRPGMOD MODULE(' + TEST_SRC_LIB + '/TSTMOD1) '                                                           000142
  1201        + 'SRCFILE(QTEMP/QTESTSRC) SRCMBR(TSTMOD1)');                                                                 000143
  1202   ExecCl('CRTSRVPGM SRVPGM(' + TEST_SRC_LIB + '/TSTSRVPGM) '                                                         000144
  1203        + 'MODULE(' + TEST_SRC_LIB + '/TSTMOD1) EXPORT(*ALL)');                                                       000145
  1204                                                                                                                      000146
  1205   // 4b. Binding Directory (TSTBNDDIR)                                                                               000147
  1206   ExecCl('CRTBNDDIR BNDDIR(' + TEST_SRC_LIB + '/TSTBNDDIR)');                                                        000148
  1207   ExecCl('ADDBNDDIRE BNDDIR(' + TEST_SRC_LIB + '/TSTBNDDIR) '                                                        000149
  1208        + 'OBJ((' + TEST_SRC_LIB + '/TSTSRVPGM *SRVPGM))');                                                           000150
  1209                                                                                                                      000151
  1210   // 4c. ILE RPG Program (TSTPGM1)                                                                                   000152
  1211   WriteSrcMbr('TSTPGM1': 'RPGLE':                                                                                    000153
  1212               '**FREE' + x'25'                                                                                       000154
  1213             + 'ctl-opt dftactgrp(*no) actgrp(*new);' + x'25'                                                         000155
  1214             + '*inlr = *on;' + x'25'                                                                                 000156
  1215             + 'return;');                                                                                            000157
  1216   ExecCl('CRTBNDRPG PGM(' + TEST_SRC_LIB + '/TSTPGM1) '                                                              000158
  1217        + 'SRCFILE(QTEMP/QTESTSRC) SRCMBR(TSTPGM1)');                                                                 000159
  1218                                                                                                                      000160
  1219   // 4d. ILE CL Program (TSTCLPGM) & CL Command (TSTCMD1)                                                            000161
  1220   WriteSrcMbr('TSTCLPGM': 'CLLE':                                                                                    000162
  1221               'PGM' + x'25'                                                                                          000163
  1222             + 'ENDPGM');                                                                                             000164
  1223   ExecCl('CRTBNDCL PGM(' + TEST_SRC_LIB + '/TSTCLPGM) '                                                              000165
  1224        + 'SRCFILE(QTEMP/QTESTSRC) SRCMBR(TSTCLPGM)');                                                                000166
  1225                                                                                                                      000167
  1226   WriteSrcMbr('TSTCMD1': 'CMD':                                                                                      000168
  1227               'CMD PROMPT(''Test Packaged Command'')');                                                              000169
  1228   ExecCl('CRTCMD CMD(' + TEST_SRC_LIB + '/TSTCMD1) '                                                                 000170
  1229        + 'PGM(' + TEST_SRC_LIB + '/TSTCLPGM) '                                                                       000171
  1230        + 'SRCFILE(QTEMP/QTESTSRC) SRCMBR(TSTCMD1)');                                                                 000172
  1231 end-proc;                                                                                                            000173
