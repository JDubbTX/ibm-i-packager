000080 ///                                                                                                                  000080
000081 // Integer Equality Assertion                                                                                        000081
000082 //                                                                                                                   000082
000083 // Compares the given Integer values expected and actual. The assertion                                              000083
000084 // fails, if both values are different.                                                                              000084
000085 //                                                                                                                   000085
000086 // Example:                                                                                                          000086
000087 //   iEqual( 1000 : balance );                                                                                       000087
000088 //                                                                                                                   000088
000089 // Message:                                                                                                          000089
000090 //   Expected 'expected', but was 'actual'.                                                                          000090
000091 //                                                                                                                   000091
000092 // If parameter 'fieldName' is specified, the message is prefixed                                                    000092
000093 // with 'fieldName:'.                                                                                                000093
000094 //                                                                                                                   000094
000095 // @param expected  - Expected value                                                                                 000095
000096 // @param actual    - Actual value                                                                                   000096
000097 // @param fieldName - Field name (optional)                                                                          000097
000098 //                                                                                                                   000098
000099 // @throws CPF9897 Expected '{expected}', but was '{actual}'.                                                        000099
000100 ///                                                                                                                  000100
000101 dcl-pr iEqual extproc('iEqual') opdesc;                                                                              000101
