000193 ///                                                                                                                  000193
000194 // Get Monitored Message                                                                                             000194
000195 //                                                                                                                   000195
000196 // Retrieves the latest *ESCAPE message from the job log. Usually                                                    000196
000197 // called within the 'on-error' section of a 'monitor' block.                                                        000197
000198 //                                                                                                                   000198
000199 // Example:                                                                                                          000199
000200 //   monitor;                                                                                                        000200
000201 //     a = 10;                                                                                                       000201
000202 //     b = 0;     // Attempt made to divide by zero for                                                              000202
000203 //     c = a / b; // fixed point operation. (MCH1211)                                                                000203
000204 //     fail( 'Division by zero did not raise an error.' );                                                           000204
000205 //   on-error;                                                                                                       000205
000206 //     msgInfo = getMonitoredMessage(*ON); // remove message                                                         000206
000207 //   endmon;                               // from job log                                                           000207
000208 //                                                                                                                   000208
000209 //   aEqual( 'MCH1211': msgInfo.Id );                                                                                000209
000210 //                                                                                                                   000210
000211 // @param doRmvMsg - Whether to remove message from job log                                                          000211
000212 //                                                                                                                   000212
000213 // @return Message information (MsgInfo_t)                                                                           000213
000214 ///                                                                                                                  000214
000215 dcl-pr getMonitoredMessage likeds(MsgInfo_t) extproc('getMonitoredMessage') opdesc;                                  000215
000216   doRmvMsg ind options(*nopass) const;                                                                               000216
000217 end-pr;                                                                                                              000217
000218                                                                                                                      000218
