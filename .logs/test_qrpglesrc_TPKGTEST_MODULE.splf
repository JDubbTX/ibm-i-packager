000747 ///                                                                                                                  000747
000748 // Asserts that 'actual' satisfies the condition specified by matcher.                                               000748
000749 //                                                                                                                   000749
000750 // Calls the 'matcher' for comparing 'actual. The assertion fails if the 'mathcer'                                   000750
000751 // return 'false'.                                                                                                   000751
000752 //                                                                                                                   000752
000753 // Example:                                                                                                          000753
000754 //   assertThat( actual : %paddr('matcher') : pUserData );                                                           000754
000755 //                                                                                                                   000755
000756 // Message:                                                                                                          000756
000757 //   ???                                                                                                             000757
000758 //                                                                                                                   000758
000759 // If parameter 'message' is specified that is appened to the log.                                                   000759
000760 //                                                                                                                   000760
000761 // @param expected - Expected value                                                                                  000761
000762 // @param actual   - Actual value                                                                                    000762
000763 // @param matcher  - Pointer to matcher procedure                                                                    000763
000764 // @param message  - Message (optional)                                                                              000764
000765 //                                                                                                                   000765
000766 // @throws CPF9897 Expected '{expected}', but was '{actual}'.                                                        000766
000767 ///                                                                                                                  000767
000768 dcl-pr assertThat opdesc extproc('assertThat');                                                                      000768
000769   expected pointer const;                                                                                            000769
000770   actual   pointer const;                                                                                            000770
000771   matcher  pointer(*proc) const;                                                                                     000771
000772   message  like(msgText_t) options(*nopass: *omit) const;                                                            000772
000773 end-pr;                                                                                                              000773
000774                                                                                                                      000774
000775 ///                                                                                                                  000775
000776 // Procedure interface of the 'matcher' callback procedure.                                                          000776
000777 //                                                                                                                   000777
000778 // The matcher procedure is called for comparing the actual result                                                   000778
000779 // with the expected value.                                                                                          000779
000780 //                                                                                                                   000780
000781 // @param pExpected   - Expected value                                                                               000781
000782 // @param pActual     - Actual value                                                                                 000782
000783 // @param message     - Message (optional)                                                                           000783
000784 // @param logExpected - Value that is displayed in the unit test log                                                 000784
000785 // @param logActual   - Value that is displayed in the unit test log                                                 000785
000786 ///                                                                                                                  000786
000787 dcl-s pMatcher_t pointer(*proc);                                                                                     000787
000788 dcl-pr matcher_t ind extproc(pMatcher_t);                                                                            000788
000789   pExpected    pointer const;                                                                                        000789
000790   pActual      pointer const;                                                                                        000790
000791   message      like(msgText_t) options(*nopass);                                                                     000791
000792   logExpected  like(logValue_t.value) options(*nopass);                                                              000792
000793   logActual    like(logValue_t.value) options(*nopass);                                                              000793
000794 end-pr;                                                                                                              000794
