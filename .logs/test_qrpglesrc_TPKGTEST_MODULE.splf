001383 //              and asserts:                                                                                         001383
001384 //              - TSTPGM1 and TSTCLPGM have USRDFNATR = 'V1.0.0-PGM'                                                 001384
001385 //              - Save file QTEMP/SAVFPGM has USRDFNATR = 'V1.0.0-PGM'                                               001385
001386 //              - Save file contains exactly 2 objects and both are *PGM                                             001386
001387 //              - Non-*PGM objects (e.g. TSTDTAARA) were NOT stamped                                                 001387
001388 // ============================================================================                                      001388
001389 dcl-proc testPackSingleObjTypePgmAndVersionStamp export;                                                             001389
001390   dcl-c EXP_VER 'V1.0.0-PGM';                                                                                        001390
001391   dcl-s CmdOk    ind;                                                                                                001391
001392   dcl-s SavfCnt  int(10);                                                                                            001392
001393                                                                                                                      001393
001394   CmdOk = ExecCl('#PACK SRCLIB(' + TEST_SRC_LIB + ') '                                                               001394
001395                + 'OBJ(*ALL) OBJTYPE(*PGM) '                                                                          001395
001396                + 'VERSION(''' + EXP_VER + ''') '                                                                     001396
001397                + 'OUTTYPE(*SAVF) SAVF(QTEMP/SAVFPGM) CLEAR(*YES)');                                                  001397
001398   assert(CmdOk: '#PACK command for OBJTYPE(*PGM) should succeed');                                                   001398
001399                                                                                                                      001399
001400   // Assert both *PGM objects are stamped with the 10-char version in USRDFNATR                                      001400
001401   aEqual(EXP_VER: GetObjVersionStamp(TEST_SRC_LIB: 'TSTPGM1': '*PGM'));                                              001401
001402   aEqual(EXP_VER: GetObjVersionStamp(TEST_SRC_LIB: 'TSTCLPGM': '*PGM'));                                             001402
001403                                                                                                                      001403
001404   // Assert the Save File itself was also stamped with the version                                                   001404
001405   aEqual(EXP_VER: GetObjVersionStamp('QTEMP': 'SAVFPGM': '*FILE'));                                                  001405
001406                                                                                                                      001406
001407   // Assert non-*PGM objects were untouched                                                                          001407
001408   aEqual(*blanks: GetObjVersionStamp(TEST_SRC_LIB: 'TSTDTAARA': '*DTAARA'));                                         001408
001409                                                                                                                      001409
001410   // Assert the Save File contains only the 2 *PGM objects                                                           001410
001411   SavfCnt = CountSavfObjects('QTEMP': 'SAVFPGM': '*ALL');                                                            001411
001412   iEqual(2: SavfCnt);                                                                                                001412
001413   iEqual(2: CountSavfObjects('QTEMP': 'SAVFPGM': '*PGM'));                                                           001413
001414 end-proc;                                                                                                            001414
