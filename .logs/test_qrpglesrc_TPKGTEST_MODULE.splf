  1702 // ============================================================================                                      000644
  1703 // Helper: WriteSrcMbr                                                                                               000645
  1704 // Description: Adds a source member in QTEMP/QTESTSRC and populates it with                                         000646
  1705 //              lines separated by LF (x'25') so fixture objects can be compiled                                     000647
  1706 // ============================================================================                                      000648
  1707 dcl-proc WriteSrcMbr;                                                                                                000649
  1708   dcl-pi *n;                                                                                                         000650
  1709     pMbrName char(10)      const;                                                                                    000651
  1710     pSrcType char(10)      const;                                                                                    000652
  1711     pSource  varchar(4096) const;                                                                                    000653
  1712   end-pi;                                                                                                            000654
  1713                                                                                                                      000655
  1714   dcl-s AliasSql varchar(512);                                                                                       000656
  1715   dcl-s LineStr  varchar(100);                                                                                       000657
  1716   dcl-s Pos      int(10);                                                                                            000658
  1717   dcl-s Start    int(10) inz(1);                                                                                     000659
  1718   dcl-s SeqNum   packed(6:2) inz(1.00);                                                                              000660
  1719                                                                                                                      000661
  1720   ExecCl('RMVM FILE(QTEMP/QTESTSRC) MBR(' + %trim(pMbrName) + ')');                                                  000662
  1721   ExecCl('ADDPFM FILE(QTEMP/QTESTSRC) MBR(' + %trim(pMbrName)                                                        000663
  1722        + ') SRCTYPE(' + %trim(pSrcType) + ')');                                                                      000664
  1723                                                                                                                      000665
  1724   AliasSql = 'CREATE OR REPLACE ALIAS QTEMP.SRCMBR FOR QTEMP.QTESTSRC ('                                             000666
  1725            + %trim(pMbrName) + ')';                                                                                  000667
  1726   exec sql EXECUTE IMMEDIATE :AliasSql;                                                                              000668
  1727                                                                                                                      000669
  1728   dow Start <= %len(pSource);                                                                                        000670
  1729     Pos = %scan(x'25': pSource: Start);                                                                              000671
  1730     if Pos = 0;                                                                                                      000672
  1731       LineStr = %subst(pSource: Start);                                                                              000673
  1732       Start = %len(pSource) + 1;                                                                                     000674
  1733     else;                                                                                                            000675
  1734       LineStr = %subst(pSource: Start: Pos - Start);                                                                 000676
  1735       Start = Pos + 1;                                                                                               000677
  1736     endif;                                                                                                           000678
  1737                                                                                                                      000679
  1738     exec sql                                                                                                         000680
  1739       INSERT INTO QTEMP.SRCMBR (SRCSEQ, SRCDAT, SRCDTA)                                                              000681
  1740       VALUES (:SeqNum, 0, :LineStr);                                                                                 000682
  1741     SeqNum += 1.00;                                                                                                  000683
  1742   enddo;                                                                                                             000684
