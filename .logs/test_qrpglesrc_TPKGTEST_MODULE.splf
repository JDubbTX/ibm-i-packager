  1627 // Description: Clears the 10-character USER_DEFINED_ATTRIBUTE (USRDFNATR)                                           000569
  1628 //              on an object via QLICOBJD so tests remain order-independent.                                         000570
  1629 // ============================================================================                                      000571
  1630 dcl-proc ResetObjVersionStamp;                                                                                       000572
