  1095 // Test Suite Constants                                                                                              000037
  1096 // ----------------------------------------------------------------------------                                      000038
  1097 dcl-c TEST_SRC_LIB  'PKGTSTSRC';                                                                                     000039
  1098 dcl-c TEST_TGT_LIB  'PKGTSTTGT';                                                                                     000040
  1099 dcl-c TEST_DTA_LIB  'PKGTSTDTA';                                                                                     000041
