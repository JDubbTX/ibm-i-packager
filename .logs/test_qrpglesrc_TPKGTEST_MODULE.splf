000049 ///                                                                                                                  000049
000050 // Alphanumeric Equality Assertion                                                                                   000050
000051 // Cobol enabled.                                                                                                    000051
000052 //                                                                                                                   000052
000053 // Compares the given String values 'expected' and 'actual'. The assertion                                           000053
000054 // fails, if both values are different.                                                                              000054
000055 //                                                                                                                   000055
000056 // Example:                                                                                                          000056
000057 //   aEqual( 'John Smith' : name );                                                                                  000057
000058 //                                                                                                                   000058
000059 // Message:                                                                                                          000059
000060 //   Expected 'expected', but was 'actual'.                                                                          000060
000061 //                                                                                                                   000061
000062 // If parameter 'fieldName' is specified, the message is prefixed                                                    000062
000063 // with 'fieldName:'.                                                                                                000063
000064 //                                                                                                                   000064
000065 // @param expected  - Expected value                                                                                 000065
000066 // @param actual    - Actual value                                                                                   000066
000067 // @param fieldName - Field name (optional)                                                                          000067
000068 //                                                                                                                   000068
000069 // @throws CPF9897 Expected '{expected}', but was '{actual}'.                                                        000069
000070 ///                                                                                                                  000070
