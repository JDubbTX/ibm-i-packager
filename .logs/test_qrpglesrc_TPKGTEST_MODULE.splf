000519 // Equality assertion                                                                                                000519
000520 //                                                                                                                   000520
000521 // Overloaded prorotype for                                                                                          000521
000522 // assertEqual_numeric,                                                                                              000522
000523 // assertEqual_float,                                                                                                000523
000524 // assertEqual_date,                                                                                                 000524
000525 // assertEqual_time,                                                                                                 000525
000526 // assertEqual_timestamp                                                                                             000526
000527 ///                                                                                                                  000527
000528 // /if not defined(DISABLE_ASSERT_EQUAL)                                                                             000528
000529 dcl-pr assertEqual overload(assertEqual_string                                                                       000529
000530                           : assertEqual_numeric                                                                      000530
000531                           : assertEqual_float                                                                        000531
000532                           : assertEqual_date                                                                         000532
000533                           : assertEqual_time                                                                         000533
000534                           : assertEqual_timestamp);                                                                  000534
