     1 **free                                                                                                               000001
     2 // ============================================================================                                      000002
     3 // Test Suite:  TPKGTEST (pkgtest.test.sqlrpgle)                                                                     000003
     4 // Source File: test/qrpglesrc/pkgtest.test.sqlrpgle                                                                 000004
     5 // Framework:   iRPGUnit (RPGUNIT) / Code for IBM i Testing Extension                                                000005
     6 // Description: Unit and integration test suite for #PACK and #UNPACK commands.                                      000006
     7 //              Verifies:                                                                                            000007
     8 //              1. Packaging specific object types (*PGM, *SRVPGM, *FILE,                                            000008
     9 //                 *DTAARA, *DTAQ, *MSGF, *MODULE, *BNDDIR, *CMD)                                                    000009
    10 //              2. Stamping the 10-char VERSION into USRDFNATR on all packaged                                       000010
    11 //                 objects and on the Save File itself                                                               000011
    12 //              3. Filtering by generic object name patterns and exporting                                           000012
    13 //                 packages to IFS stream files                                                                      000013
    14 //              4. Unpacking in strict dependency precedence order while                                             000014
    15 //                 preserving the 10-char version attribute                                                          000015
    16 //              5. Preserving all object authorities and applying JSON                                               000016
    17 //                 MAPFILE library mappings and per-file preserveData overrides                                      000017
    18 //                                                                                                                   000018
    19 // Compile with iRPGUnit:                                                                                            000019
    20 //   RUCRTRPG TSTPGM(PACKAGER/TPKGTEST) +                                                                            000020
    21 //            SRCSTMF('/path/to/test/qrpglesrc/pkgtest.test.sqlrpgle') +                                             000021
    22 //            INCDIR('/path/to/src/qrpglesrc') RPGPPOPT(*LVL2)                                                       000022
    23 // Run:                                                                                                              000023
    24 //   RUCALLTST TSTPGM(PACKAGER/TPKGTEST)                                                                             000024
    25 // ============================================================================                                      000025
    26 ctl-opt nomain ccsidcvt(*excp) ccsid(*char : *jobrun)                                                                000026
    27         option(*srcstmt : *nodebugio) bnddir('RPGUNIT/IRPGUNIT');                                                    000027
000028                                                                                                                      000028
000029 // Include iRPGUnit assertion prototypes (aEqual, iEqual, assert, fail, etc.)                                        000029
000030 // /include qinclude,TESTCASE                                                                                        000030
000031 **END-FREE                                                                                                           000031
