000134 ///                                                                                                                  000134
000135 // General Purpose Assertion                                                                                         000135
000136 // Cobol enabled.                                                                                                    000136
000137 //                                                                                                                   000137
000138 // Checks the specified Boolean expression for true. The assertion fails,                                            000138
000139 // if the expression evaluates to false. When the assertion fails, the                                               000139
000140 // value of 'message' is added to the test report.                                                                   000140
000141 //                                                                                                                   000141
000142 // Example 1:                                                                                                        000142
000143 //   assert( newTime > oldTime : 'newTime is not larger than oldTime' );                                             000143
000144 //                                                                                                                   000144
000145 // Message:                                                                                                          000145
000146 //   newTime is not larger than oldTime                                                                              000146
000147 //                                                                                                                   000147
000148 // Example 2:                                                                                                        000148
000149 //   assert( %not eof : 'Missing record in file XXX' );                                                              000149
000150 //                                                                                                                   000150
000151 // Message:                                                                                                          000151
000152 //   Missing record in file XXX                                                                                      000152
000153 //                                                                                                                   000153
000154 // @param condition  - Condition to test                                                                             000154
000155 // @param msgIfFalse - Message if false (optional)                                                                   000155
000156 //                                                                                                                   000156
000157 // @throws CPF9897 {msgIfFalse}, e.g. 'Missing record in file XXX'                                                   000157
000158 ///                                                                                                                  000158
000159 dcl-pr assert extproc('assert') opdesc;                                                                              000159
000160   condition  ind const;                                                                                              000160
000161 //  /if defined(RPGUNIT_INTERNAL)                                                                                    000161
000162 //  /else                                                                                                            000162
000163   msgIfFalse varchar(16384) options(*varsize: *nopass) const;                                                        000163
000164 //  /endif                                                                                                           000164
000165 end-pr;                                                                                                              000165
000166                                                                                                                      000166
000167 ///                                                                                                                  000167
000168 // Fail test                                                                                                         000168
000169 // Cobol enabled.                                                                                                    000169
000170 //                                                                                                                   000170
000171 // Produces an error and appends the specified 'message' to the test                                                 000171
000172 // report. The test case is terminated.                                                                              000172
000173 //                                                                                                                   000173
000174 // Example:                                                                                                          000174
000175 //   monitor;                                                                                                        000175
000176 //     call PGM();                                                                                                   000176
000177 //     fail( 'PGM should have thrown an exception' );                                                                000177
000178 //   on-error;                                                                                                       000178
000179 //     // Exception seen. Success.                                                                                   000179
000180 //   endmon;                                                                                                         000180
000181 //                                                                                                                   000181
000182 // @param msg - Message                                                                                              000182
