000538 ///                                                                                                                  000538
000539 // Aphanumeric Equality Assertion                                                                                    000539
000540 //                                                                                                                   000540
000541 // Compares the given String values 'expected' and 'actual'. The assertion                                           000541
000542 // fails, if both values are different.                                                                              000542
000543 //                                                                                                                   000543
000544 // Example:                                                                                                          000544
000545 //   assertEqual( 'John Smith' : name );                                                                             000545
000546 //                                                                                                                   000546
000547 // Message:                                                                                                          000547
000548 //   Expected 'John Smith', but was 'actual'.                                                                        000548
000549 //                                                                                                                   000549
000550 // If parameter 'message' is specified that is appened to the log.                                                   000550
000551 //                                                                                                                   000551
000552 // @param expected - Expected value                                                                                  000552
000553 // @param actual   - Actual value                                                                                    000553
000554 // @param message  - Message (optional)                                                                              000554
000555 //                                                                                                                   000555
000556 // @throws CPF9897 Expected '{expected}', but was '{actual}'.                                                        000556
000557 ///                                                                                                                  000557
000558 dcl-pr assertEqual_string opdesc extproc('assertEqual_string');                                                      000558
000559   expected like(assertString_t) options(*varsize) const;                                                             000559
000560   actual   like(assertString_t) options(*varsize) const;                                                             000560
000561   message  like(msgText_t) options(*nopass: *omit) const;                                                            000561
000562 end-pr;                                                                                                              000562
