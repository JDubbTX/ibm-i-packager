  954   // ----------------------------------------------------------------------------                        000055   10/18/26
  955   // Command & JSON Parameter Structures for #UNPACK Library Mapping                                     000056   10/18/26
  956   // ----------------------------------------------------------------------------                        000057   10/18/26
  957   // Mapping rule: Map (ObjName, ObjType, ObjExtendedAttr) -> Target Library                             000058   10/18/26
  958   //               with optional PreserveData override ('Y', 'N', or ' ')                                000059   10/18/26
  959   dcl-ds LibMapEntry_t qualified template;                                                               000060   10/18/26
  960     ObjName      char(10); // *ALL, exact name, or generic 'ABC*'                                        000061   10/18/26
  961     ObjType      char(10); // e.g. *FILE, *PGM, *SRVPGM, *ALL                                            000062   10/18/26
  962     ObjAttr      char(10); // e.g. *ALL, PF, LF, DSPF, PRTF, TB, VW, IX, RPGLE                           000063   10/18/26
  963     TgtLib       char(10); // Target library for matching objects                                        000064   10/18/26
  964     PreserveData char(1);  // 'Y' = preserve data, 'N' = overwrite, ' ' = default                        000065   10/18/26
  965   end-ds;                                                                                                000066   10/18/26
  966                                                                                                          000067   10/18/26
  967   // Explicit per-file override from JSON MAPFILE ("fileOverrides" array)                                000068   10/18/26
  968   dcl-ds FileDataOverride_t qualified template;                                                          000069   10/18/26
  969     FileName     char(10); // Exact file name or generic 'ABC*'                                          000070   10/18/26
  970     TgtLib       char(10); // Optional target library override for this file                             000071   10/18/26
  971     PreserveData char(1);  // 'Y' = preserve existing data, 'N' = do not preserve                        000072   10/18/26
  972   end-ds;                                                                                                000073   10/18/26
  973                                                                                                          000074   10/18/26
  974   // ----------------------------------------------------------------------------                        000075   10/18/26
  975   // QLICOBJD - Change Object Description API                                                            000076   10/18/26
  976   // Used to stamp the 10-character version into USRDFNATR (Key 9)                                       000077   10/18/26
  977   // ----------------------------------------------------------------------------                        000078   10/18/26
  978   dcl-pr QLICOBJD extpgm('QLICOBJD');                                                                    000079   10/18/26
  979     RtnLib        char(10);                                                                              000080   10/18/26
  980     QualObjName   char(20) const;                                                                        000081   10/18/26
  981     ObjType       char(10) const;                                                                        000082   10/18/26
  982     ChangedInfo   char(64) const options(*varsize);                                                      000083   10/18/26
  983     ErrorCode     likeds(ApiError_t);                                                                    000084   10/18/26
  984   end-pr;                                                                                                000085   10/18/26
  985                                                                                                          000086   10/18/26
  986   // Key 9 structure for QLICOBJD: User-defined attribute (10 chars)                                     000087   10/18/26
  987   dcl-ds ChgObjUsrDfnAtr_t qualified template;                                                           000088   10/18/26
  988     NumRcds   int(10) inz(1);                                                                            000089   10/18/26
  989     Key       int(10) inz(9);      // Key 9 = User-defined attribute                                     000090   10/18/26
  990     DataLen   int(10) inz(10);     // Length = 10 bytes                                                  000091   10/18/26
  991     UsrDfnAtr char(10) inz(*blanks);                                                                     000092   10/18/26
  992   end-ds;                                                                                                000093   10/18/26
  993                                                                                                          000094   10/18/26
