 1188     // 4. Create Source Physical File in QTEMP to compile *MODULE, *SRVPGM,                              000127   10/18/26
 1189     //    *PGM (RPGLE & CLLE), and *CMD fixtures                                                         000128   10/18/26
 1190     ExecCl('DLTF FILE(QTEMP/QTESTSRC)');                                                                 000129   10/18/26
 1191     ExecCl('CRTSRCPF FILE(QTEMP/QTESTSRC) RCDLEN(112)');                                                 000130   10/18/26
 1192                                                                                                          000131   10/18/26
 1193     // 4a. RPGLE Module & Service Program (TSTMOD1 -> TSTSRVPGM)                                         000132   10/18/26
 1194     WriteSrcMbr('TSTMOD1': 'RPGLE':                                                                      000133   10/18/26
 1195                 '**FREE' + x'25'                                                                         000134   10/18/26
 1196               + 'ctl-opt nomain;' + x'25'                                                                000135   10/18/26
 1197               + 'dcl-proc CalcTax export;' + x'25'                                                       000136   10/18/26
 1198               + '  dcl-pi *n packed(11:2);' + x'25'                                                      000137   10/18/26
 1199               + '    pAmt packed(11:2) const;' + x'25'                                                   000138   10/18/26
 1200               + '  end-pi;' + x'25'                                                                      000139   10/18/26
 1201               + '  return pAmt * 0.05;' + x'25'                                                          000140   10/18/26
 1202               + 'end-proc;');                                                                            000141   10/18/26
 1203     ExecCl('CRTRPGMOD MODULE(' + TEST_SRC_LIB + '/TSTMOD1) '                                             000142   10/18/26
 1204          + 'SRCFILE(QTEMP/QTESTSRC) SRCMBR(TSTMOD1)');                                                   000143   10/18/26
 1205     ExecCl('CRTSRVPGM SRVPGM(' + TEST_SRC_LIB + '/TSTSRVPGM) '                                           000144   10/18/26
 1206          + 'MODULE(' + TEST_SRC_LIB + '/TSTMOD1) EXPORT(*ALL)');                                         000145   10/18/26
 1207                                                                                                          000146   10/18/26
 1208     // 4b. Binding Directory (TSTBNDDIR)                                                                 000147   10/18/26
 1209     ExecCl('CRTBNDDIR BNDDIR(' + TEST_SRC_LIB + '/TSTBNDDIR)');                                          000148   10/18/26
 1210     ExecCl('ADDBNDDIRE BNDDIR(' + TEST_SRC_LIB + '/TSTBNDDIR) '                                          000149   10/18/26
 1211          + 'OBJ((' + TEST_SRC_LIB + '/TSTSRVPGM *SRVPGM))');                                             000150   10/18/26
 1212                                                                                                          000151   10/18/26
 1213     // 4c. ILE RPG Program (TSTPGM1)                                                                     000152   10/18/26
 1214     WriteSrcMbr('TSTPGM1': 'RPGLE':                                                                      000153   10/18/26
 1215                 '**FREE' + x'25'                                                                         000154   10/18/26
 1216               + 'ctl-opt dftactgrp(*no) actgrp(*new);' + x'25'                                           000155   10/18/26
 1217               + '*inlr = *on;' + x'25'                                                                   000156   10/18/26
 1218               + 'return;');                                                                              000157   10/18/26
 1219     ExecCl('CRTBNDRPG PGM(' + TEST_SRC_LIB + '/TSTPGM1) '                                                000158   10/18/26
