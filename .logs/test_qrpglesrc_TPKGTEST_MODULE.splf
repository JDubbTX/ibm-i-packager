000930   BytesAvailable int(10) inz(0);                                                                                     000930
000931   ExceptionId    char(7) inz(*blanks);                                                                               000931
000932   Reserved       char(1) inz(x'00');                                                                                 000932
000933   ExceptionData  char(256) inz(*blanks);                                                                             000933
000934 end-ds;                                                                                                              000934
000935                                                                                                                      000935
000936 // ----------------------------------------------------------------------------                                      000936
