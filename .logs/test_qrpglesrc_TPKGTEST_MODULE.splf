000917 dcl-c TIER_PHYSICAL_DATA    20; // *FILE (PF, PF-DTA, PF-SRC, SQL TABLE)                                             000917
000918 dcl-c TIER_LOGICAL_DATA     30; // *FILE (LF, SQL VIEW, SQL INDEX, MQT)                                              000918
000919 dcl-c TIER_DEVICE_UI        40; // *FILE (DSPF, PRTF, ICFF), *PNLGRP, *MENU                                          000919
000920 dcl-c TIER_MODULES_BND      50; // *MODULE, *BNDDIR                                                                  000920
000921 dcl-c TIER_SRVPGM           60; // *SRVPGM                                                                           000921
