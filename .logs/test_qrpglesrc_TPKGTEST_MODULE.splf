  1652 // ============================================================================                                      000594
  1653 // Helper: CountSavfObjects                                                                                          000595
  1654 // Description: Uses QSRLSAVF (SAVF0200) to count how many objects (optionally                                       000596
  1655 //              filtered by pObjType) are stored inside a Save File.                                                 000597
  1656 // ============================================================================                                      000598
  1657 dcl-proc CountSavfObjects;                                                                                           000599
  1658   dcl-pi *n int(10);                                                                                                 000600
  1659     pSavfLib char(10) const;                                                                                         000601
  1660     pSavf    char(10) const;                                                                                         000602
  1661     pObjType char(10) const;                                                                                         000603
  1662   end-pi;                                                                                                            000604
  1663                                                                                                                      000605
  1664   dcl-c USRSPC_NAME 'TSTSPC    QTEMP     ';                                                                          000606
  1665   dcl-ds ApiErr     likeds(ApiError_t) inz(*likeds);                                                                 000607
  1666   dcl-ds QualSavf   likeds(QualName_t);                                                                              000608
  1667   dcl-s  SpcPtr     pointer;                                                                                         000609
  1668   dcl-ds SpcHdr     likeds(UsrSpcHeader_t) based(SpcPtr);                                                            000610
  1669   dcl-s  EntryPtr   pointer;                                                                                         000611
  1670   dcl-ds Entry      likeds(SAVI0200_t) based(EntryPtr);                                                              000612
  1671   dcl-s  idx        int(10);                                                                                         000613
  1672   dcl-s  MatchCount int(10) inz(0);                                                                                  000614
  1673                                                                                                                      000615
  1674   QUSCRTUS(USRSPC_NAME: 'TEST      ': 65536: x'00': '*ALL      ':                                                    000616
  1675            'Test Save File Check': '*YES      ': ApiErr);                                                            000617
  1676   if ApiErr.BytesAvailable > 0;                                                                                      000618
  1677     return -1;                                                                                                       000619
  1678   endif;                                                                                                             000620
  1679                                                                                                                      000621
  1680   QualSavf.Name = pSavf;                                                                                             000622
  1681   QualSavf.Lib  = pSavfLib;                                                                                          000623
  1682                                                                                                                      000624
  1683   QSRLSAVF(USRSPC_NAME: 'SAVF0200': QualSavf: '*ALL      ': '*ALL      ':                                            000625
  1684            *blanks: ApiErr);                                                                                         000626
  1685   if ApiErr.BytesAvailable > 0;                                                                                      000627
  1686     QUSDLTUS(USRSPC_NAME: ApiErr);                                                                                   000628
