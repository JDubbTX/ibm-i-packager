001908 // ============================================================================                                      001908
001909 // Helper: CountSavfObjects                                                                                          001909
001910 // Description: Uses QSRLSAVF (SAVF0200) to count how many objects (optionally                                       001910
001911 //              filtered by pObjType) are stored inside a Save File.                                                 001911
001912 // ============================================================================                                      001912
001913 dcl-proc CountSavfObjects;                                                                                           001913
001914   dcl-pi *n int(10);                                                                                                 001914
001915     pSavfLib char(10) const;                                                                                         001915
001916     pSavf    char(10) const;                                                                                         001916
001917     pObjType char(10) const;                                                                                         001917
001918   end-pi;                                                                                                            001918
001919                                                                                                                      001919
001920   dcl-c USRSPC_NAME 'TSTSPC    QTEMP     ';                                                                          001920
001921   dcl-ds ApiErr     likeds(ApiError_t) inz(*likeds);                                                                 001921
001922   dcl-ds QualSavf   likeds(QualName_t);                                                                              001922
001923   dcl-s  SpcPtr     pointer;                                                                                         001923
001924   dcl-ds SpcHdr     likeds(UsrSpcHeader_t) based(SpcPtr);                                                            001924
001925   dcl-s  EntryPtr   pointer;                                                                                         001925
001926   dcl-ds Entry      likeds(SAVI0200_t) based(EntryPtr);                                                              001926
001927   dcl-s  idx        int(10);                                                                                         001927
001928   dcl-s  MatchCount int(10) inz(0);                                                                                  001928
001929                                                                                                                      001929
001930   QUSCRTUS(USRSPC_NAME: 'TEST      ': 65536: x'00': '*ALL      ':                                                    001930
001931            'Test Save File Check': '*YES      ': ApiErr);                                                            001931
001932   if ApiErr.BytesAvailable > 0;                                                                      B01             001932
001933     return -1;                                                                                        01             001933
001934   endif;                                                                                             E01             001934
001935                                                                                                                      001935
001936   QualSavf.Name = pSavf;                                                                                             001936
001937   QualSavf.Lib  = pSavfLib;                                                                                          001937
001938                                                                                                                      001938
001939   QSRLSAVF(USRSPC_NAME: 'SAVF0200': QualSavf: '*ALL      ': '*ALL      ':                                            001939
001940            *blanks: ApiErr);                                                                                         001940
001941   if ApiErr.BytesAvailable > 0;                                                                      B01             001941
001942     QUSDLTUS(USRSPC_NAME: ApiErr);                                                                    01             001942
001943     return -1;                                                                                        01             001943
001944   endif;                                                                                             E01             001944
001945                                                                                                                      001945
001946   QUSPTRUS(USRSPC_NAME: SpcPtr: ApiErr);                                                                             001946
001947   for idx = 1 to SpcHdr.NumEntries;                                                                  B01             001947
001948     EntryPtr = SpcPtr + SpcHdr.ListOffset + ((idx - 1) * SpcHdr.EntrySize);                           01             001948
001949     if %trim(pObjType) = '*ALL' or %trim(Entry.ObjType) = %trim(pObjType);                           B02             001949
001950       MatchCount += 1;                                                                                02             001950
001951     endif;                                                                                           E02             001951
001952   endfor;                                                                                            E01             001952
001953                                                                                                                      001953
001954   QUSDLTUS(USRSPC_NAME: ApiErr);                                                                                     001954
001955   return MatchCount;                                                                                                 001955
001956 end-proc;                                                                                                            001956
