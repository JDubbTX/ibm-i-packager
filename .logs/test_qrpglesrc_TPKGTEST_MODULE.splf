000954 // ----------------------------------------------------------------------------                                      000954
000955 // Command & JSON Parameter Structures for #UNPACK Library Mapping                                                   000955
000956 // ----------------------------------------------------------------------------                                      000956
000957 // Mapping rule: Map (ObjName, ObjType, ObjExtendedAttr) -> Target Library                                           000957
000958 //               with optional PreserveData override ('Y', 'N', or ' ')                                              000958
000959 dcl-ds LibMapEntry_t qualified template;                                                                             000959
000960   ObjName      char(10); // *ALL, exact name, or generic 'ABC*'                                                      000960
000961   ObjType      char(10); // e.g. *FILE, *PGM, *SRVPGM, *ALL                                                          000961
000962   ObjAttr      char(10); // e.g. *ALL, PF, LF, DSPF, PRTF, TB, VW, IX, RPGLE                                         000962
000963   TgtLib       char(10); // Target library for matching objects                                                      000963
000964   PreserveData char(1);  // 'Y' = preserve data, 'N' = overwrite, ' ' = default                                      000964
000965 end-ds;                                                                                                              000965
000966                                                                                                                      000966
000967 // Explicit per-file override from JSON MAPFILE ("fileOverrides" array)                                              000967
000968 dcl-ds FileDataOverride_t qualified template;                                                                        000968
000969   FileName     char(10); // Exact file name or generic 'ABC*'                                                        000969
000970   TgtLib       char(10); // Optional target library override for this file                                           000970
000971   PreserveData char(1);  // 'Y' = preserve existing data, 'N' = do not preserve                                      000971
000972 end-ds;                                                                                                              000972
000973                                                                                                                      000973
000974 // ----------------------------------------------------------------------------                                      000974
