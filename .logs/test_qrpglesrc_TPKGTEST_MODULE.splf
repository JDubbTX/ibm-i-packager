 1128     // invoke their respective CL Command Processing Programs (PACKC / UNPACKC)                          000067   10/18/26
 1129     ExecCl('CHGCMD CMD(' + %trim(ToolLib) + '/PACK) PGM('                                                000068   10/18/26
 1130          + %trim(ToolLib) + '/PACKC)');                                                                  000069   10/18/26
 1131     ExecCl('CRTDUPOBJ OBJ(PACK) FROMLIB(' + %trim(ToolLib)                                               000070   10/18/26
 1132          + ') OBJTYPE(*CMD) TOLIB(' + %trim(ToolLib) + ') NEWOBJ(#PACK)');                               000071   10/18/26
