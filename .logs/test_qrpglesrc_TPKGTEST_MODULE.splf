  1595 // ============================================================================                                      000537
  1596 // Helper: GetObjVersionStamp                                                                                        000538
  1597 // Description: Queries QSYS2.OBJECT_STATISTICS to retrieve the 10-character                                         000539
  1598 //              USER_DEFINED_ATTRIBUTE (USRDFNATR) of an object.                                                     000540
  1599 // ============================================================================                                      000541
  1600 dcl-proc GetObjVersionStamp;                                                                                         000542
  1601   dcl-pi *n char(10);                                                                                                000543
  1602     pLib  char(10) const;                                                                                            000544
  1603     pObj  char(10) const;                                                                                            000545
  1604     pType char(10) const;                                                                                            000546
  1605   end-pi;                                                                                                            000547
  1606                                                                                                                      000548
  1607   dcl-s UsrAtr char(10) inz(*blanks);                                                                                000549
  1608                                                                                                                      000550
  1609   exec sql                                                                                                           000551
  1610     SELECT COALESCE(USER_DEFINED_ATTRIBUTE, '')                                                                      000552
  1611       INTO :UsrAtr                                                                                                   000553
  1612       FROM TABLE(QSYS2.OBJECT_STATISTICS(                                                                            000554
  1613                    OBJECT_SCHEMA => :pLib,                                                                           000555
  1614                    OBJTYPELIST   => :pType,                                                                          000556
  1615                    OBJECT_NAME   => :pObj)) AS X                                                                     000557
  1616      FETCH FIRST 1 ROW ONLY;                                                                                         000558
  1617                                                                                                                      000559
  1618   if sqlcode <> 0;                                                                                                   000560
  1619     return *blanks;                                                                                                  000561
  1620   endif;                                                                                                             000562
  1621                                                                                                                      000563
  1622   return UsrAtr;                                                                                                     000564
  1623 end-proc;                                                                                                            000565
  1624                                                                                                                      000566
  1625 // ============================================================================                                      000567
