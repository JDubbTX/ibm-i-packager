  1482 // ============================================================================                                      000424
  1483 // Test 6: testUnpackReplaceAuthoritiesAndJsonOverrides                                                              000425
  1484 // Description: Verifies that #UNPACK with a JSON MAPFILE:                                                           000426
  1485 //              1. Routes *FILE (PF/LF) to PKGTSTDTA and *PGM/*SRVPGM to                                             000427
  1486 //                 PKGTSTPGM                                                                                         000428
  1487 //              2. Preserves private authorities granted on existing objects                                         000429
  1488 //              3. Preserves existing customer rows in TSTCUSTPF                                                     000430
  1489 //                 (preserveData: true)                                                                              000431
  1490 //              4. Overwrites reference data in TSTSYSCFG with package seed                                          000432
  1491 //                 rows (preserveData: false override)                                                               000433
  1492 // ============================================================================                                      000434
  1493 dcl-proc testUnpackReplaceAuthoritiesAndJsonOverrides export;                                                        000435
  1494   dcl-c EXP_VER   'REL-26.10B';                                                                                      000436
  1495   dcl-c JSON_PATH '/tmp/pkgtest_map.json';                                                                           000437
  1496   dcl-s JsonText  varchar(2048);                                                                                     000438
  1497   dcl-s CmdOk     ind;                                                                                               000439
  1498   dcl-s RowCnt    int(10) inz(0);                                                                                    000440
  1499   dcl-s CfgVal    char(30) inz(*blanks);                                                                             000441
  1500   dcl-s PubAut    varchar(20) inz('');                                                                               000442
  1501                                                                                                                      000443
  1502   // 1. Package PKGTSTSRC with version 'REL-26.10B'                                                                  000444
  1503   CmdOk = ExecCl('#PACK SRCLIB(' + TEST_SRC_LIB + ') '                                                               000445
  1504                + 'OBJ(*ALL) OBJTYPE(*ALL) '                                                                          000446
  1505                + 'VERSION(''' + EXP_VER + ''') '                                                                     000447
  1506                + 'OUTTYPE(*SAVF) SAVF(QTEMP/SAVFALL) CLEAR(*YES)');                                                  000448
  1507   assert(CmdOk: '#PACK should succeed');                                                                             000449
  1508                                                                                                                      000450
  1509   // 2. Write JSON MAPFILE to IFS                                                                                    000451
  1510   JsonText = '{'                                                                                                     000452
  1511            + '"defaultLibrary": "' + TEST_PGM_LIB + '",'                                                             000453
  1512            + '"defaultPreserveData": true,'                                                                          000454
  1513            + '"libraryMap": ['                                                                                       000455
  1514            + '  {"objectType": "*FILE", "objectAttribute": "PF", '                                                   000456
  1515            + '   "targetLibrary": "' + TEST_DTA_LIB + '"},'                                                          000457
  1516            + '  {"objectType": "*FILE", "objectAttribute": "LF", '                                                   000458
