  134   ///                                                                                                    010400   01/25/26
  135   // General Purpose Assertion                                                                           010500   01/25/26
  136   // Cobol enabled.                                                                                      010600   01/25/26
  137   //                                                                                                     010700   01/25/26
  138   // Checks the specified Boolean expression for true. The assertion fails,                              010800   01/25/26
  139   // if the expression evaluates to false. When the assertion fails, the                                 010900   01/25/26
  140   // value of 'message' is added to the test report.                                                     011000   01/25/26
  141   //                                                                                                     011100   01/25/26
  142   // Example 1:                                                                                          011200   01/25/26
  143   //   assert( newTime > oldTime : 'newTime is not larger than oldTime' );                               011300   01/25/26
  144   //                                                                                                     011400   01/25/26
  145   // Message:                                                                                            011500   01/25/26
  146   //   newTime is not larger than oldTime                                                                011600   01/25/26
  147   //                                                                                                     011700   01/25/26
  148   // Example 2:                                                                                          011800   01/25/26
  149   //   assert( %not eof : 'Missing record in file XXX' );                                                011900   01/25/26
  150   //                                                                                                     012000   01/25/26
  151   // Message:                                                                                            012100   01/25/26
